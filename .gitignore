# Data & artifacts
data/raw/*
# (data/raw/FLIR_E8_collected/ — real employee thermal captures — already covered by the
# data/raw/* rule above; called out explicitly since it holds identifiable personal data.)
data/processed/*
data/landmarks/*
data/roi_temperatures/*
data/labels/*
!data/**/.gitkeep
!data/labels/population_baseline.json
!data/labels/engagement_labels.json

checkpoints/*
!checkpoints/.gitkeep

# auto-downloaded MediaPipe model + OpenCV cascade XMLs, not authored here.
# Anchored to repo root (leading /) — an unanchored "models/" also matched src/models/,
# which silently excluded resnet_backbone.py from ever being tracked. Caught before commit.
/models/

logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Streamlit
.streamlit/secrets.toml
